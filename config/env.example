# ═══════════════════════════════════════════════════════════════════════
#  Polymarket Bot — environment configuration
#  Copy to config/.env and fill in real values. NEVER commit real keys.
# ═══════════════════════════════════════════════════════════════════════

# ── SECRETS (Polymarket wallet) ─────────────────────────────────────────
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
POLYMARKET_FUNDER_ADDRESS=0xYOUR_PROXY_WALLET_ADDRESS

# ── General ─────────────────────────────────────────────────────────────
POLY_INITIAL_BALANCE=7.0
POLY_ASSETS=["BTC","ETH"]
POLY_INTERVAL_MINUTES=5

# ── Paper trading (simulate, no real orders) ────────────────────────────
# Set to "true" while testing the dashboard / strategies.
POLY_PAPER_TRADING=false

# ── Strategy toggles ────────────────────────────────────────────────────
POLY_VACUUM_SCALP_ENABLED=true
POLY_EARLY_TREND_ENABLED=false
POLY_STANDARD_ENTRY_ENABLED=false

# ── Risk management (★) ────────────────────────────────────────────────
# Per-position stop losses (fraction of entry price)
POLY_VACUUM_SCALP_SL_PCT=0.10
POLY_EARLY_TREND_SL_PCT=0.10
POLY_STANDARD_SL_PCT=0.10

# Portfolio-level guards (NEW — did not exist in the original script)
POLY_MAX_CONCURRENT_POSITIONS=2
POLY_MAX_DAILY_LOSS_PCT=0.20
POLY_MAX_DRAWDOWN_PCT=0.35

# Cascading SL behaviour
POLY_NUCLEAR_CRASH_PCT=0.15
POLY_NUCLEAR_SELL_PRICE=0.01
POLY_SL_CHASE_STEP_PCT=0.02
POLY_SL_MAX_CHASE_ROUNDS=3
POLY_SL_DYNAMIC_SLIPPAGE_PCT=0.03

# Position sizing
POLY_MAX_STAKE_RATIO=0.75
POLY_VACUUM_SCALP_MAX_STAKE_RATIO=0.72
POLY_BALANCE_SAFETY_MARGIN=0.98

# ── Dashboard ───────────────────────────────────────────────────────────
POLY_DASHBOARD_HOST=0.0.0.0
POLY_DASHBOARD_PORT=8000

# Dashboard password (leave empty for no auth — local dev only)
# Set a password when deploying to a VPS!
POLY_DASHBOARD_PASSWORD=

# Set AUTOSTART_BOT=1 to start trading immediately when the app launches.
AUTOSTART_BOT=0
